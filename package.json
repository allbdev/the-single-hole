{
  "name": "the-single-hole",
  "version": "0.1.0",
  "private": true,
  "description": "Um Buraco Só: everyone on the internet digs the same hole, live.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n room,web -c gray,cyan \"npm:dev:room\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:room": "tsx watch server/adapters/node.ts",
    "room": "tsx server/adapters/node.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "playwright test",
    "load": "tsx load/ws-load.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "world-countries": "^5.1.0"
  }
}
